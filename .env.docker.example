# ==============================================================================
# Smart Asset Location Tracker - Docker Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the workspace root or update 'backend/.env'.
# 2. Fill in strong production passwords and secret keys.
# 3. DO NOT commit the active '.env' file containing real secrets to version control.
# ==============================================================================

# --- Django Core Configuration ---
# In production, set DEBUG=False and generate a cryptographically strong SECRET_KEY.
SECRET_KEY=django-insecure-replace-with-a-50-character-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.103,yourdomain.com

# --- MySQL 8 Container Database Credentials ---
# The containerized database service is named 'db'.
DB_NAME=smart_tracker_db
DB_USER=tracker_user
DB_PASSWORD=tracker_strong_password_change_me_2026
DB_ROOT_PASSWORD=mysql_root_strong_password_change_me_2026
DB_HOST=db
DB_PORT=3306

# --- CORS & Security Controls ---
# Before public deployment, restrict CORS to specific authorized origins.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8000,http://192.168.0.103:8000
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=True

# --- Asset & Hardware Configuration ---
DEFAULT_ASSET_ID=ASSET-ESP32-01
DEFAULT_GEOFENCE_RADIUS_METERS=500

# --- API & IoT Device Access Control Tokens ---
# Rotate these tokens before deploying to any public or shared network!
DEVICE_SECRET_TOKEN=esp32_device_secret_token_change_in_production
DASHBOARD_API_KEY=dashboard_admin_key_change_in_production

