#ifndef SECRETS_H
#define SECRETS_H

// Template for ESP32 Network & Backend Credentials
// Copy this file to 'secrets.h' in the same folder and enter your real values.
// NOTE: 'secrets.h' is in .gitignore to avoid committing private credentials.

// Wi-Fi Credentials
#define WIFI_SSID "Your_WiFi_SSID"
#define WIFI_PASSWORD "Your_WiFi_Password"

// Django Backend Server URL
// Use your development machine's local LAN IP (e.g., http://192.168.1.50:8000)
// Do not use localhost or 127.0.0.1 on the ESP32.
#define DJANGO_SERVER_URL "http://192.168.1.100:8000"

// Hardware Identity & Authentication
#define DEVICE_ID "ASSET-ESP32-01"
#define DEVICE_TOKEN "esp32_token_mca_default"

#endif // SECRETS_H

