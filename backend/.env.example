# Django Environment Variables Configuration Template
# Copy this file to '.env' and update the values with your local settings.

# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-smart-tracker-mca-project-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.*

# MySQL 8 Database Credentials
DB_NAME=smart_tracker_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Asset Default Configuration
DEFAULT_ASSET_ID=ASSET-ESP32-01
DEFAULT_GEOFENCE_RADIUS_METERS=500

# API Security Credentials
DEVICE_SECRET_TOKEN=esp32_device_secret_token_change_in_production
DASHBOARD_API_KEY=dashboard_admin_key_change_in_production

